{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "src/styles/globals.css"
  },
  "ignorePatterns": [
    "node_modules/",
    ".pnpm-store/",
    ".next/",
    "out/",
    "dist/",
    "build/",
    ".wrangler/",
    "src/routeTree.gen.ts",
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock",
    "*.min.js",
    "*.min.css",
    "*.log",
    ".env",
    ".env.local",
    ".env.*.local",
    ".DS_Store"
  ]
}
