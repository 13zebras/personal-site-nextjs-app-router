{
  // OXC - default formatter (oxfmt)
  "editor.defaultFormatter": "oxc.oxc-vscode",

  // Format on save with oxfmt
  "editor.formatOnSave": true,

  // Language-specific formatters
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  // oxlint fix on save
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },

  // File associations
  "files.associations": {
    "*.css": "css"
  }
}
